/* =============================================================================
 * Multi-Controller — 全局主题（Qt QSS）
 * 目标：精密仪器控制面板。浅色、信息密集、状态醒目、操作层级清晰。
 * 设计令牌（token）：
 *   背景窗口  #EEF1F6   面板/卡片 #FFFFFF   描边     #D6DDE7
 *   主操作色  #2F6FED   主色悬停  #245BC9   主色按下 #1D4FC0
 *   成功/已连 #22A55A   警示      #E8A23D   危险/断连 #D64045
 *   文本主    #1A2233   文本次    #667085   数值等宽  #35539C
 * ========================================================================== */

/* ---- 基础 ---------- */
QMainWindow, QDialog {
    background-color: #EEF1F6;
}
QMainWindow {
    font-family: "Segoe UI", "Microsoft YaHei UI";
    font-size: 13px;
    color: #1A2233;
}

/* ---- 分组容器 ---------- */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #D6DDE7;
    border-radius: 8px;
    margin-top: 18px;          /* 为标题让位 */
    padding: 12px 12px 12px 12px;
    font-weight: 600;
    color: #1A2233;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: 4px;
    padding: 0 6px;
    background-color: #FFFFFF;
    color: #35539C;
    font-weight: 700;
}

/* ---- 按钮：默认（次要操作） ---------- */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #C6CFDD;
    border-radius: 6px;
    padding: 5px 14px;
    min-height: 26px;
    color: #1A2233;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #F2F6FC;
    border-color: #9DB3D6;
}
QPushButton:pressed {
    background-color: #E4ECF7;
    border-color: #7E9BC9;
}
QPushButton:disabled {
    background-color: #F4F6FA;
    border-color: #E3E7EE;
    color: #ABB4C2;
}

/* ---- 主操作按钮：连接/断开 ---------- */
QPushButton#connectBtn {
    background-color: #2F6FED;
    border-color: #2F6FED;
    color: #FFFFFF;
}
QPushButton#connectBtn:hover  { background-color: #245BC9; border-color: #245BC9; }
QPushButton#connectBtn:pressed{ background-color: #1D4FC0; border-color: #1D4FC0; }
QPushButton#connectBtn:disabled { background-color: #B9C9E6; border-color: #B9C9E6; color: #FFFFFF; }

/* ---- 输入：下拉框 ---------- */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #C6CFDD;
    border-radius: 6px;
    padding: 5px 10px;
    min-height: 24px;
    color: #1A2233;
}
QComboBox:hover { border-color: #9DB3D6; }
QComboBox:focus { border-color: #2F6FED; }
QComboBox:disabled { background-color: #F4F6FA; color: #ABB4C2; border-color: #E3E7EE; }
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: none;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #C6CFDD;
    border-radius: 6px;
    color: #1A2233;
    outline: 0;
    padding: 4px;
}
QComboBox QAbstractItemView::item {
    min-height: 26px;
    padding: 2px 8px;
    border-radius: 4px;
}
QComboBox QAbstractItemView::item:selected {
    background-color: #E4ECF7;
    color: #1A2233;
}

/* ---- 输入：数字框 ---------- */
QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #C6CFDD;
    border-radius: 6px;
    padding: 4px 6px;
    min-height: 24px;
    color: #1A2233;
    font-family: "Consolas", "Menlo", monospace;
    font-weight: 600;
}
QSpinBox:hover, QDoubleSpinBox:hover { border-color: #9DB3D6; }
QSpinBox:focus, QDoubleSpinBox:focus { border-color: #2F6FED; }
QSpinBox:disabled, QDoubleSpinBox:disabled { background-color: #F4F6FA; color: #ABB4C2; border-color: #E3E7EE; }
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #EEF1F6;
    border: none;
    width: 20px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #DDE4EE;
}

/* ---- 文本标签 ---------- */
QLabel { color: #667085; background: transparent; }
QLabel[emphasis="true"] { color: #1A2233; font-weight: 600; }
QGroupBox QLabel { color: #667085; }

/* ---- 当前位置读数（状态醒目） ---------- */
#positionLabel {
    color: #35539C;
    font-family: "Consolas", "Menlo", monospace;
    font-size: 17px;
    font-weight: 700;
    background-color: #EDF3FF;
    border: 1px solid #C9DBFF;
    border-radius: 6px;
    padding: 3px 10px;
}

/* ---- 连接状态文字（配色由代码按状态切换） ---------- */
#connectionStatusLabel, #cameraStatusLabel {
    font-weight: 700;
}

/* ---- 日志面板 ---------- */
QPlainTextEdit#logTextEdit {
    background-color: #FBFCFE;
    border: 1px solid #D6DDE7;
    border-radius: 6px;
    color: #2A3040;
    font-family: "Consolas", "Menlo", monospace;
    font-size: 12px;
    padding: 4px;
    selection-background-color: #C9DBFF;
    selection-color: #1A2233;
}

/* ---- 相机预览区 ---------- */
#cameraDisplayLabel {
    background-color: #0D1117;   /* 深底，突出真实画面 */
    border: 1px solid #2A3340;
    border-radius: 8px;
    color: #8B96A8;
}

/* ---- 分割器手柄 ---------- */
QSplitter::handle {
    background-color: #D6DDE7;
    border-radius: 2px;
}
QSplitter::handle:hover { background-color: #2F6FED; }
QSplitter::handle:horizontal { width: 3px; margin: 14px 2px; }

/* ---- 菜单栏 ---------- */
QMenuBar {
    background-color: #E4E9F1;
    color: #1A2233;
    border-bottom: 1px solid #D6DDE7;
}
QMenuBar::item { background: transparent; padding: 5px 12px; border-radius: 4px; }
QMenuBar::item:selected { background: #D5E3FA; }
QMenuBar::item:pressed { background: #C9DBFF; }
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #C6CFDD;
    border-radius: 6px;
    padding: 6px;
    color: #1A2233;
}
QMenu::item {
    padding: 6px 26px 6px 18px;
    border-radius: 4px;
}
QMenu::item:selected { background: #E4ECF7; color: #1A2233; }
QMenu::item:disabled { color: #ABB4C2; }
QMenu::indicator { width: 12px; height: 12px; margin-left: 4px; }
QMenu::separator { height: 1px; background: #E3E7EE; margin: 5px 8px; }

/* ---- 状态栏 ---------- */
QStatusBar {
    background-color: #E4E9F1;
    border-top: 1px solid #D6DDE7;
    color: #1A2233;
    font-size: 12px;
}
QStatusBar::item { border: none; }

/* ---- 工具提示 ---------- */
QToolTip {
    background-color: #1A2233;
    color: #F4F6FA;
    border: none;
    border-radius: 4px;
    padding: 6px 9px;
    font-size: 12px;
}

/* ---- 滚动条（日志/下拉） ---------- */
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #C6CFDD; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #9DB3D6; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #C6CFDD; border-radius: 4px; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: #9DB3D6; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }