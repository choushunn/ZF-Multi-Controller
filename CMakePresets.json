{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc-base",
      "hidden": true,
      "description": "MSVC 公共设置：Visual Studio 2022 x64 + Ninja 单配置生成器。需在 VS x64 开发者环境（cl.exe 在 PATH）中运行。",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "C:/Qt/6.7.3/msvc2019_64",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC 2022 x64 Debug",
      "description": "Visual Studio 2022 x64 Debug，完整构建含硬件层（KDC101/DVP2 经 MSVC .lib）。",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC 2022 x64 Release",
      "description": "Visual Studio 2022 x64 Release，完整构建含硬件层。",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "mingw-base",
      "hidden": true,
      "description": "MinGW 公共设置：MinGW Makefiles 生成器 + gcc/g++。禁用硬件层（MC_ENABLE_HARDWARE=OFF），因厂商 SDK 仅提供 MSVC ABI 的 .lib，无 .a。",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "C:/Qt/6.7.3/mingw_64",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "MC_ENABLE_HARDWARE": "OFF"
      }
    },
    {
      "name": "mingw-debug",
      "displayName": "MinGW g++ Debug (no hardware)",
      "description": "MinGW g++ Debug，仅编译 core/CLI/tests，硬件层禁用。",
      "inherits": "mingw-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mingw-release",
      "displayName": "MinGW g++ Release (no hardware)",
      "description": "MinGW g++ Release，仅编译 core/CLI/tests，硬件层禁用。",
      "inherits": "mingw-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "msvc-debug", "configurePreset": "msvc-debug" },
    { "name": "msvc-release", "configurePreset": "msvc-release" },
    { "name": "mingw-debug", "configurePreset": "mingw-debug" },
    { "name": "mingw-release", "configurePreset": "mingw-release" }
  ],
  "testPresets": [
    { "name": "msvc-debug", "configurePreset": "msvc-debug", "configuration": "Debug" },
    { "name": "msvc-release", "configurePreset": "msvc-release", "configuration": "Release" },
    { "name": "mingw-debug", "configurePreset": "mingw-debug", "configuration": "Debug" },
    { "name": "mingw-release", "configurePreset": "mingw-release", "configuration": "Release" }
  ]
}
